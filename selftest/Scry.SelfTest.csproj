<Project Sdk="Microsoft.NET.Sdk">

  <!-- The in-game self-test, a plugin of its own beside Scry that reaches into it through
       InternalsVisibleTo. Built and deployed with a development build:
                 dotnet build selftest -c Debug
       It is never packaged with a release, which takes Scry.dll alone. -->
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <AssemblyName>Scry.SelfTest</AssemblyName>
    <RootNamespace>Scry</RootNamespace>
    <LangVersion>latest</LangVersion>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <DebugType>portable</DebugType>
    <NoWarn>$(NoWarn);CS0649</NoWarn>
  </PropertyGroup>

  <!-- Doc comments are checked as Scry's are (see Scry.csproj). -->
  <PropertyGroup>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <WarningsAsErrors>$(WarningsAsErrors);CS0419;CS1570;CS1572;CS1573;CS1574;CS1580;CS1581;CS1584;CS1734</WarningsAsErrors>
  </PropertyGroup>

  <Import Project="../GameReferences.props" />

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <ProjectReference Include="../Scry.csproj" Private="false" />
  </ItemGroup>

  <Target Name="DeployToProfile" AfterTargets="Build"
          Condition="'$(LibsDir)' == '' And Exists('$(BepInExDir)\plugins')">
    <MakeDir Directories="$(DeployDir)" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(DeployDir)" ContinueOnError="true" />
    <Message Importance="high" Text="Scry.SelfTest -> $(DeployDir)" />
  </Target>

</Project>
