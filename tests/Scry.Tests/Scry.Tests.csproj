<Project Sdk="Microsoft.NET.Sdk">

  <!-- Tests for the parts of Scry that need no game: what kind a prefab is, searching and
       filtering the catalog, what a preview copy keeps, the modifiers, favourites and telling the
       game's prefabs from a mod's. The model has no Unity or BepInEx reference, so nothing else
       is needed to build it here.
       Run with: dotnet test tests/Scry.Tests
       Not part of Scry.sln, so the plugin build never builds it. -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <RootNamespace>Scry.Tests</RootNamespace>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="../../src/Model/*.cs" />
    <Compile Include="../../tools/shapes/ShapeList.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <!-- The standards tests compile Scry's whole source as the build does, with the reference
       copies in lib/ and the .NET Framework 4.7.2 reference assemblies, and read it with the
       compiler's own types (the compiler version the SDK builds with). -->
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.11.0" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies.net472" Version="1.0.3" GeneratePathProperty="true" ExcludeAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>Net472References</_Parameter1>
      <_Parameter2>$(PkgMicrosoft_NETFramework_ReferenceAssemblies_net472)/build/.NETFramework/v4.7.2</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>

</Project>
