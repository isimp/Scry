<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <AssemblyName>Scry</AssemblyName>
    <RootNamespace>Scry</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Version>0.2.0</Version>
    <Authors>isimp</Authors>
    <Product>Scry</Product>
    <Description>Browse every prefab in the game and preview it: look at creatures, items and pieces, play sounds and effects, fly projectiles and show status effects, without anything entering the world.</Description>
    <Copyright>Copyright (c) 2026 isimp</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <DebugType>portable</DebugType>
    <NoWarn>$(NoWarn);CS0649</NoWarn>
  </PropertyGroup>

  <!-- Where the references come from. Two ways, because a machine with the game on it and a
       build server have nothing in common:

       Local:  a Valheim install and a BepInEx profile, and the build deploys into the profile
               when it finishes. Override either if yours differ.
                 dotnet build -p:ValheimDir=... -p:ProfileDir=...

       Anywhere else: one flat folder of DLLs. lib/ in this repository holds metadata-only
       copies, regenerated by tools/strip-references.ps1. Setting it touches nothing local,
       deploy included.
                 dotnet build -p:LibsDir=lib -->
  <PropertyGroup>
    <!-- -p:ValheimDir=... wins, then the VALHEIM_DIR environment variable, then a stock Steam
         install. Set VALHEIM_DIR once if your library lives on another drive. -->
    <ValheimDir Condition="'$(ValheimDir)' == '' And '$(VALHEIM_DIR)' != ''">$(VALHEIM_DIR)</ValheimDir>
    <ValheimDir Condition="'$(ValheimDir)' == ''">C:\Program Files (x86)\Steam\steamapps\common\Valheim</ValheimDir>
    <ProfileDir Condition="'$(ProfileDir)' == ''">$(AppData)\com.kesomannen.gale\valheim\profiles\Default</ProfileDir>
    <BepInExDir>$(ProfileDir)\BepInEx</BepInExDir>
    <DeployDir>$(BepInExDir)\plugins\Scry</DeployDir>
  </PropertyGroup>

  <PropertyGroup Condition="'$(LibsDir)' == ''">
    <ManagedDir>$(ValheimDir)\valheim_Data\Managed</ManagedDir>
    <CoreDir>$(BepInExDir)\core</CoreDir>
  </PropertyGroup>

  <PropertyGroup Condition="'$(LibsDir)' != ''">
    <ManagedDir>$(LibsDir)</ManagedDir>
    <CoreDir>$(LibsDir)</CoreDir>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <!-- The tests build the model on their own. -->
  <ItemGroup>
    <Compile Remove="tests/**" />
    <Compile Remove="tools/**" />
  </ItemGroup>

  <!-- Forward slashes on purpose: Windows accepts them, and CI builds this on Linux. -->
  <ItemGroup>
    <Reference Include="BepInEx"><HintPath>$(CoreDir)/BepInEx.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="0Harmony"><HintPath>$(CoreDir)/0Harmony.dll</HintPath><Private>false</Private></Reference>

    <Reference Include="assembly_valheim"><HintPath>$(ManagedDir)/assembly_valheim.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="assembly_utils"><HintPath>$(ManagedDir)/assembly_utils.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="assembly_guiutils"><HintPath>$(ManagedDir)/assembly_guiutils.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="SoftReferenceableAssets"><HintPath>$(ManagedDir)/SoftReferenceableAssets.dll</HintPath><Private>false</Private></Reference>

    <Reference Include="UnityEngine"><HintPath>$(ManagedDir)/UnityEngine.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.CoreModule"><HintPath>$(ManagedDir)/UnityEngine.CoreModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.PhysicsModule"><HintPath>$(ManagedDir)/UnityEngine.PhysicsModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.AudioModule"><HintPath>$(ManagedDir)/UnityEngine.AudioModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.AnimationModule"><HintPath>$(ManagedDir)/UnityEngine.AnimationModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.ParticleSystemModule"><HintPath>$(ManagedDir)/UnityEngine.ParticleSystemModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.InputLegacyModule"><HintPath>$(ManagedDir)/UnityEngine.InputLegacyModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.IMGUIModule"><HintPath>$(ManagedDir)/UnityEngine.IMGUIModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.AssetBundleModule"><HintPath>$(ManagedDir)/UnityEngine.AssetBundleModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.TextRenderingModule"><HintPath>$(ManagedDir)/UnityEngine.TextRenderingModule.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>

  <Target Name="DeployToProfile" AfterTargets="Build"
          Condition="'$(LibsDir)' == '' And Exists('$(BepInExDir)\plugins')">
    <MakeDir Directories="$(DeployDir)" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(DeployDir)" ContinueOnError="true" />
    <Message Importance="high" Text="Scry -> $(DeployDir)" />
  </Target>

</Project>
